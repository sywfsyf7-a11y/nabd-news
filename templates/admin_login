<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>دخول الإدارة | World Pulse</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-950 text-slate-100 grid place-items-center p-5"><main class="w-full max-w-md rounded-2xl border border-slate-700 bg-slate-900 p-7 shadow-xl"><h1 class="text-2xl font-bold mb-2">لوحة مراجعة المصادر والتراخيص</h1><p class="text-slate-400 mb-6">دخول مخصص لمدير الموقع فقط.</p>{% if error %}<p class="mb-4 rounded bg-red-950 p-3 text-red-200">{{ error }}</p>{% endif %}<form method="post" class="space-y-4"><label class="block">كلمة مرور الإدارة<input required type="password" name="password" autocomplete="current-password" class="mt-2 w-full rounded-lg bg-slate-800 border border-slate-600 p-3"></label><button class="w-full rounded-lg bg-cyan-600 p-3 font-bold hover:bg-cyan-500">دخول</button></form></main></body></html>
