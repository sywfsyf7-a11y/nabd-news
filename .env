# Copy these names into Render Environment as needed; do not commit real secrets.
FLASK_SECRET_KEY=
SUPABASE_POOLER_URL=
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SITE_URL=https://your-domain.example

# Optional commercial image APIs; keep blank unless you have valid API access.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# IMPORTANT: leave empty unless you have the licence/permission required for that exact publisher.
# Use exact publisher root domains only, e.g. bloomberg.com after licensing.
PUBLISHER_LICENSED_DOMAINS=

# Optional mail configuration for the contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Source and image rights review panel (/admin/sources). Use unique strong credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional workload controls (defaults are used if removed).
MAX_IMAGE_LOOKUPS_PER_REFRESH=48
MAX_IMAGE_BACKFILL_PER_REFRESH=24
MAX_EDITORIAL_BACKFILL_PER_REFRESH=4
IMAGE_SEARCH_TIMEOUT_SECONDS=5
