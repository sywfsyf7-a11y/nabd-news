# Required for stable production operation
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
SUPABASE_POOLER_URL=postgresql://user:password@host:6543/database?sslmode=require
GEMINI_API_KEY=replace-with-your-own-key
SITE_URL=https://your-public-domain.example

# Optional image providers; without these, the site uses eligible Wikimedia Commons images and its safe placeholder
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional contact form mail settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

NEWS_AUTO_FETCH=true
NEWS_REFRESH_MINUTES=15
MAX_ARTICLES_PER_REFRESH=24
MAX_ARTICLES_PER_CATEGORY=4
MAX_IMAGE_LOOKUPS_PER_REFRESH=24
