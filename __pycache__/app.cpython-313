                    SET image_url = '', image_source = 'none', image_credit = '',
                        image_credit_url = '', image_provider_url = '', image_license_url = '', image_checked_at = NULL
                    WHERE image_source IN ('publisher_rss', 'publisher_page', 'category')
                       OR image_url = ANY(%s)
