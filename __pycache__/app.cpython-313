                            image_license_url ~* 'https?://creativecommons\.org/licenses/by/(2\.0|3\.0|4\.0)/?$'
                            OR image_license_url ~* 'https?://creativecommons\.org/publicdomain/(zero|mark)/1\.0/?$'
                       ))
